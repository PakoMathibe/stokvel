# =====================================================================
# Environment configuration
# =====================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env.local to git.
# =====================================================================

# Public site URL. Used for metadata, OG images, sitemap, canonical URLs.
# In StackBlitz, set this to your preview URL:
#   https://your-project-xxxxx.stackblitz.io
# In production, set it to your real domain:
#   https://stokvelmanager.co.za
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# PHASE 2 — Supabase (add when the dashboard is built)
# ---------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# PHASE 4 — Notifications (add when messaging is wired)
# ---------------------------------------------------------------------
# RESEND_API_KEY=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------
# PHASE 4 — Payment provider (add when/if a provider is onboarded)
# ---------------------------------------------------------------------
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=